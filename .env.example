# ==============================================================================
# EduQuery V3 — Environment Configuration Template
# ==============================================================================

# Application Environment: 'development', 'production', or 'testing'
EDUQUERY_ENV=production

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# Database Persistence Path
# Set to file path for persistence across container/server restarts
# Set to ':memory:' only for ephemeral test executions
EDUQUERY_DATABASE_PATH=data/eduquery.duckdb

# Root Directory for Uploaded Datasets, Reviews, and Pointer
EDUQUERY_DATA_DIR=data

# Active Dataset Pointer JSON File
EDUQUERY_ACTIVE_POINTER_PATH=data/active_dataset.json

# Administrative Secret Key
# Optional / Admin-only: Reserved exclusively for backend administrative operations
# (e.g., legacy rollback via /api/v1/import/rollback).
# NEVER required or requested from faculty during normal upload, analysis, or deletion.
# Generate with: openssl rand -hex 24
EDUQUERY_IMPORT_API_KEY=change-this-to-a-secure-random-token-in-production

# CORS Allowed Origins (Comma-separated)
# In production, restrict to official college portal / faculty domain
EDUQUERY_CORS_ORIGINS=https://faculty.college.edu,http://localhost:5173

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
EDUQUERY_LOG_LEVEL=INFO

# Maximum Upload Size (Bytes): Default 25MB (26214400 bytes)
EDUQUERY_MAX_UPLOAD_SIZE_BYTES=26214400

# Import Session Time-To-Live (Seconds): Default 3600 (1 hour)
EDUQUERY_IMPORT_SESSION_TTL_SECONDS=3600

# Directory for Ephemeral Analysis Sessions
# Defaults to /tmp/eduquery-sessions in Linux/Docker containers, or data/sessions locally
EDUQUERY_TEMPORARY_SESSIONS_DIR=/tmp/eduquery-sessions

# ==============================================================================
# Faculty Identity Gateway (Zero Trust / Cloudflare Access)
# ==============================================================================

# Enable strict zero-trust gateway enforcement in production: 'true' or 'false'
# When true, requests must include a valid Cf-Access-Jwt-Assertion or gateway secret.
EDUQUERY_GATEWAY_AUTH_REQUIRED=false

# Cloudflare Access Team Domain (e.g. college-faculty.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com

# Cloudflare Access Application Audience Tag (AUD)
CF_ACCESS_AUD=your-application-aud-tag

# Optional Shared Secret Header (e.g. for custom reverse proxies or Cloudflare Transform Rules)
EDUQUERY_GATEWAY_SHARED_SECRET=
