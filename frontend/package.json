{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "build:verify": "node ../scripts/check-contrast.mjs && node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build && node ../scripts/check-bundle-budget.mjs",
    "check:contrast": "node ../scripts/check-contrast.mjs",
    "check:budget": "node ../scripts/check-bundle-budget.mjs",
    "lint": "node ./node_modules/oxlint/dist/cli.js",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:smoke": "node ../scripts/run-axe-and-smoke.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
